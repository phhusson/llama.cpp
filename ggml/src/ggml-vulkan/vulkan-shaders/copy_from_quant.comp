#version 450

#extension GL_EXT_control_flow_attributes : require

#include "types.glsl"
#include "generic_unary_head.glsl"
#include "dequant_funcs.glsl"

#if defined(NEEDS_INIT_IQ_SHMEM)
// 16 invocations needed for init_iq_shmem
layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;
#else
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
#endif

#if defined(DATA_D_BF16)
D_TYPE to_dtype(float v) {
    return D_TYPE(fp32_to_bf16(v));
}
#else
D_TYPE to_dtype(float v) {
    return D_TYPE(v);
}
#endif

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
    if (gl_LocalInvocationIndex.x != 0) {
        return;
    }
#endif

    const uint idx = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x * QUANT_K;

    if (idx >= p.ne) {
        return;
    }

    uint dst_idx = get_doffset() + dst_idx(idx);
    uint src_idx = src0_idx_quant(idx, QUANT_K);

    const uint a_offset = 0;
    const uint ib = src_idx;
    const vec2 dm = get_dm(ib, a_offset);

    [[unroll]] for (int j = 0; j < QUANT_K; j += 4) {
        vec4 v = dequantize4(ib, j / QUANT_R, a_offset);
        v = v * dm.x + vec4(dm.y);

#if QUANT_R == 2
        data_d[dst_idx + j/2 +             0] = to_dtype(v[0]);
        data_d[dst_idx + j/2 + QUANT_K/2 + 0] = to_dtype(v[1]);
        data_d[dst_idx + j/2 +             1] = to_dtype(v[2]);
        data_d[dst_idx + j/2 + QUANT_K/2 + 1] = to_dtype(v[3]);
#else
        data_d[dst_idx + j + 0] = to_dtype(v[0]);
        data_d[dst_idx + j + 1] = to_dtype(v[1]);
        data_d[dst_idx + j + 2] = to_dtype(v[2]);
        data_d[dst_idx + j + 3] = to_dtype(v[3]);
#endif
    }
}
